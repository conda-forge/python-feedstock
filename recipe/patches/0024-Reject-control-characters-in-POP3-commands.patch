diff --git a/Lib/poplib.py b/Lib/poplib.py
index 9eb662d..5c83522 100644
--- a/Lib/poplib.py
+++ b/Lib/poplib.py
@@ -122,6 +122,8 @@ def _putline(self, line):
     def _putcmd(self, line):
         if self._debugging: print('*cmd*', repr(line))
         line = bytes(line, self.encoding)
+        if re.search(b'[\x00-\x1F\x7F]', line):
+            raise ValueError('Control characters not allowed in commands')
         self._putline(line)
 
 
diff --git a/Lib/test/test_poplib.py b/Lib/test/test_poplib.py
index f1ebbea..46d788a 100644
--- a/Lib/test/test_poplib.py
+++ b/Lib/test/test_poplib.py
@@ -395,6 +395,14 @@ def test_quit(self):
         self.assertIsNone(self.client.sock)
         self.assertIsNone(self.client.file)
 
+    def test_control_characters(self):
+        for char in test_support.control_characters_c0():
+            with self.subTest(char=char):
+                with self.assertRaises(ValueError):
+                    self.client.user(f'user{char}')
+                with self.assertRaises(ValueError):
+                    self.client.pass_(f'{char}pass')
+
     @requires_ssl
     def test_stls_capa(self):
         capa = self.client.capa()
