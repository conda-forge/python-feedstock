From c9ebb07b34a3804ba2bf874dc3127cb92c19cae9 Mon Sep 17 00:00:00 2001
From: "Uwe L. Korn" <uwe.korn@quantco.com>
Date: Tue, 5 Sep 2023 21:51:31 +0200
Subject: [PATCH 21/26] Override configure LIBFFI

---
 configure | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure b/configure
index 2cd1442f7cf..20ebfa2ce56 100755
--- a/configure
+++ b/configure
@@ -15453,7 +15453,7 @@ if test "x$ac_cv_lib_ffi_ffi_call" = xyes
 then :
 
                 have_libffi=yes
-        LIBFFI_CFLAGS=${LIBFFI_CFLAGS-"-I${SDKROOT}/usr/include/ffi -DUSING_APPLE_OS_LIBFFI=1"}
+        LIBFFI_CFLAGS=${LIBFFI_CFLAGS-"-I${PREFIX}/include -DUSING_APPLE_OS_LIBFFI=0"}
         LIBFFI_LIBS=${LIBFFI_LIBS-"-lffi"}
 
 fi
